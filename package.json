{
	"name": "deepvault",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "lock/open a directory as a single cascaded-encrypted file",
	"license": "SEE LICENSE",
	"files": [],
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"format": "prettier --check \".prettierrc.json\" \".markdownlint.json\" \"package.json\" \".vscode/*.json\" \"lib/**/*.{js,jsx,mjs,json,css,html,htmx}\" \"bin/**/*.{js,jsx,mjs}\"",
		"format:fix": "prettier --write \".prettierrc.json\" \".markdownlint.json\" \"package.json\" \".vscode/*.json\" \"lib/**/*.{js,jsx,mjs,json,css,html,htmx}\" \"bin/**/*.{js,jsx,mjs}\"",
		"lint": "eslint lib/ bin/",
		"check": "npm run lint && npm run format",
		"test": "node --test test/"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.9.1",
		"prettier": "^3.9.6"
	}
}
